<Window x:Class="BluetoothPlus.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth+ — configurações" Width="520" Height="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,18,22,8">

        <!-- ============================== Bateria -->
        <TextBlock Text="Aviso de bateria fraca" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" Margin="0,4,0,12"
                   Text="Escolha em qual porcentagem você quer ser avisado para cada tipo de aparelho conectado. Arraste até o início para desligar o aviso daquele tipo."/>

        <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Aplicar o mesmo valor a todos os tipos" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="AllBox" Grid.Column="1" Width="130" SelectionChanged="AllBox_SelectionChanged"/>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="6">
          <ItemsControl x:Name="Rows">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="8,7,10,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Surface}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16"
                               Foreground="{Binding Brush}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,8,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <Slider Grid.Column="2" Minimum="0" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding ValueLabel}" HorizontalAlignment="Right"
                             VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Restaurar padrão (20%)" Click="Reset_Click"/>
          <Button Content="Enviar aviso de teste" Click="TestNotification_Click"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" FontSize="12" Margin="0,8,0,0"
                   Text="Se o aviso de teste não aparecer, verifique se o modo Não incomodar (Assistente de foco) do Windows está desligado."/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="22,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" IsCancel="True"/>
        <Button Content="Salvar" Style="{StaticResource AccentButton}" Click="Save_Click" IsDefault="True" Margin="0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
