<Window x:Class="BluetoothPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bluetooth+" Width="1240" Height="780" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============================== Cabeçalho -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Logo vetorial (o .ico ampliado ficava borrado) -->
        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#FF3B82F6" Offset="0"/>
              <GradientStop Color="#FF1D4ED8" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE702;" FontSize="20" Foreground="White"
                     HorizontalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Bluetooth+" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="CountText" Foreground="{DynamicResource TextDim}" FontSize="12"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Column="1" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged"/>
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource TextDim}"
                   Margin="12,0,0,0" IsHitTestVisible="False"/>
        <TextBlock x:Name="FilterPlaceholder" Text="Buscar por nome, tipo ou endereço"
                   Foreground="{DynamicResource TextDim}" Margin="35,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Grid>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CreditsButton" Click="CreditsButton_Click" ToolTip="Créditos" Padding="11,8">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="15"/>
        </Button>
        <Button x:Name="SettingsButton" Click="SettingsButton_Click" ToolTip="Configurações (avisos de bateria)"
                Padding="11,8">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15"/>
        </Button>
        <Button x:Name="ThemeButton" Click="ThemeButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
            <TextBlock x:Name="ThemeLabel"/>
          </StackPanel>
        </Button>
        <Button x:Name="RadioToggle" Click="RadioToggle_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE702;" Margin="0,0,8,0"/>
            <TextBlock x:Name="RadioLabel" Text="Bluetooth"/>
          </StackPanel>
        </Button>
        <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Click="ScanButton_Click" Margin="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ScanGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" Margin="0,0,8,0"/>
            <TextBlock x:Name="ScanLabel" Text="Pausar busca"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ============================== Corpo -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10*" MinWidth="420"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="9*"/>
      </Grid.ColumnDefinitions>

      <!-- Lista de dispositivos -->
      <Border Style="{StaticResource Card}" Padding="10,12,6,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource DeviceListItem}"
                   SelectionChanged="DevicesList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="10,6,0,8">
                      <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}"/>
                      <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Ícone da categoria -->
                  <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource Surface}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding CategoryGlyph}" FontSize="20"
                               Foreground="{Binding CategoryBrush}" HorizontalAlignment="Center"/>
                  </Border>

                  <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextDim}" FontSize="12.5" Margin="0,2,0,0"/>
                  </StackPanel>

                  <!-- Bateria -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                              Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding BatteryGlyph}" FontSize="15" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding BatteryLabel}" FontSize="12"/>
                  </StackPanel>

                  <!-- Barras de sinal -->
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                              Background="Transparent" ToolTip="{Binding RssiLabel}">
                    <Rectangle Width="4" Height="5" RadiusX="1" RadiusY="1" Fill="{DynamicResource Text}" Margin="0,0,2,0" VerticalAlignment="Bottom"
                               Opacity="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=1}"/>
                    <Rectangle Width="4" Height="8" RadiusX="1" RadiusY="1" Fill="{DynamicResource Text}" Margin="0,0,2,0" VerticalAlignment="Bottom"
                               Opacity="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=2}"/>
                    <Rectangle Width="4" Height="11" RadiusX="1" RadiusY="1" Fill="{DynamicResource Text}" Margin="0,0,2,0" VerticalAlignment="Bottom"
                               Opacity="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=3}"/>
                    <Rectangle Width="4" Height="14" RadiusX="1" RadiusY="1" Fill="{DynamicResource Text}" VerticalAlignment="Bottom"
                               Opacity="{Binding SignalLevel, Converter={StaticResource SignalBar}, ConverterParameter=4}"/>
                  </StackPanel>

                  <!-- Estado -->
                  <!-- Estado: texto sempre claro; a cor fica só na bolinha -->
                  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="96">
                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource Neutral}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaired}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource Gold}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource Ok}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusLabel}" FontSize="12.5"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Estado vazio -->
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE702;" FontSize="42" Foreground="{DynamicResource TextDim}"
                       HorizontalAlignment="Center" Opacity="0.6"/>
            <TextBlock x:Name="EmptyText" Text="Procurando dispositivos por perto…" Foreground="{DynamicResource TextDim}"
                       Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Aparelhos ocultos (marcados pelo usuário ou sem nome) -->
          <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="10,10,6,0" Margin="0,6,4,0">
            <CheckBox x:Name="ShowHiddenBox" Foreground="{DynamicResource TextDim}" VerticalContentAlignment="Center"
                      Checked="ShowHiddenBox_Changed" Unchecked="ShowHiddenBox_Changed"/>
          </Border>
        </Grid>
      </Border>

      <!-- ============================== Coluna direita -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="220"/>
          <RowDefinition Height="16"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Radar -->
        <Border Style="{StaticResource Card}">
          <Grid>
            <TextBlock Text="RADAR DE PROXIMIDADE" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="mais perto = mais ao centro" Foreground="{DynamicResource TextDim}" FontSize="12"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <Canvas x:Name="RadarCanvas" Margin="0,24,0,0" ClipToBounds="True" Background="Transparent"/>
          </Grid>
        </Border>

        <!-- Detalhes -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="DetailIconTile" Width="56" Height="56" CornerRadius="14">
                  <TextBlock x:Name="DetailGlyph" Style="{StaticResource Glyph}" FontSize="26" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="DetailSubtitle" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <!-- Estatísticas -->
              <UniformGrid Columns="3" Margin="0,14,0,12">
                <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,9" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="SINAL" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="StatSignal" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,9" Margin="3,0">
                  <StackPanel>
                    <TextBlock Text="BATERIA" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock x:Name="StatBatteryGlyph" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,6,0"/>
                      <TextBlock x:Name="StatBattery" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,9" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="ESTADO" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <Ellipse x:Name="StatStatusDot" Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"/>
                      <TextBlock x:Name="StatStatus" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </UniformGrid>

              <TextBlock Text="HISTÓRICO DE SINAL" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <Border CornerRadius="10" Background="{DynamicResource Surface}" Margin="0,0,0,14">
                <Canvas x:Name="SignalCanvas" Height="96" ClipToBounds="True"/>
              </Border>

              <WrapPanel>
                <WrapPanel.Resources>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,8"/>
                  </Style>
                </WrapPanel.Resources>
                <Button x:Name="PairButton" Style="{StaticResource AccentButton}" Margin="0,0,8,8" Click="PairButton_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" Margin="0,0,8,0"/>
                    <TextBlock Text="Parear"/>
                  </StackPanel>
                </Button>
                <Button x:Name="UnpairButton" Click="UnpairButton_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0,0,8,0"/>
                    <TextBlock Text="Remover"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BatteryButton" Click="BatteryButton_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,8,0"/>
                    <TextBlock Text="Bateria"/>
                  </StackPanel>
                </Button>
                <Button x:Name="FindButton" Click="FindButton_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81D;" Margin="0,0,8,0"/>
                    <TextBlock Text="Encontrar"/>
                  </StackPanel>
                </Button>
                <Button x:Name="EditButton" Click="EditButton_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" Margin="0,0,8,0"/>
                    <TextBlock Text="Editar"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
              <TextBlock x:Name="DetailAddress" Foreground="{DynamicResource TextDim}" FontSize="12" Margin="2,4,0,0"/>
            </StackPanel>

            <StackPanel x:Name="DetailEmpty" Margin="0,24" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B3;" FontSize="30" Foreground="{DynamicResource TextDim}"
                         HorizontalAlignment="Center" Opacity="0.6"/>
              <TextBlock Text="Selecione um dispositivo para ver detalhes" Foreground="{DynamicResource TextDim}" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ============================== Rodapé -->
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,12,0,0" Foreground="{DynamicResource TextDim}" FontSize="12"/>
  </Grid>
</Window>
