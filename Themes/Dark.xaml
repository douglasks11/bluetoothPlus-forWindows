<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tema escuro: texto quase branco, cor só em ícones e indicadores. -->
  <SolidColorBrush x:Key="Bg" Color="#FF121418"/>
  <SolidColorBrush x:Key="Panel" Color="#FF1B1E25"/>
  <SolidColorBrush x:Key="PanelBorder" Color="#FF2C313C"/>
  <SolidColorBrush x:Key="Surface" Color="#FF262A34"/>
  <SolidColorBrush x:Key="SurfaceHover" Color="#FF2A2F3A"/>
  <SolidColorBrush x:Key="Selection" Color="#FF2B3A55"/>
  <SolidColorBrush x:Key="Text" Color="#FFF4F5F8"/>
  <SolidColorBrush x:Key="TextDim" Color="#FFB8BECB"/>
  <SolidColorBrush x:Key="Accent" Color="#FF2F6FEB"/>
  <SolidColorBrush x:Key="AccentBorder" Color="#FF5B8DEF"/>
  <SolidColorBrush x:Key="Ok" Color="#FF3DD68C"/>
  <SolidColorBrush x:Key="Gold" Color="#FFF5C242"/>
  <SolidColorBrush x:Key="Neutral" Color="#FF8A919E"/>
  <SolidColorBrush x:Key="ScrollThumb" Color="#40FFFFFF"/>

  <!-- Radar / gráfico -->
  <SolidColorBrush x:Key="RadarGrid" Color="#30FFFFFF"/>
  <SolidColorBrush x:Key="RadarLabel" Color="#B0FFFFFF"/>
  <SolidColorBrush x:Key="RadarName" Color="#FFF4F5F8"/>
  <SolidColorBrush x:Key="RadarNameBackdrop" Color="#D91B1E25"/>
  <RadialGradientBrush x:Key="RadarGlow">
    <GradientStop Color="#304F8CFF" Offset="0"/>
    <GradientStop Color="#004F8CFF" Offset="1"/>
  </RadialGradientBrush>
</ResourceDictionary>
